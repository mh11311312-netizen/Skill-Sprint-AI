# Copy this file to .env and fill in real values. NEVER commit .env to GitHub.
SECRET_KEY=change-this-to-a-long-random-string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=skillsprint
# GenAI provider: openai or gemini
GENAI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
# GPT-5 family only: low = faster and fewer tokens
GENAI_REASONING_EFFORT=minimal
# Only needed if GENAI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GENAI_TEMPERATURE=0.2
GENAI_MAX_RETRIES=3
FLASK_DEBUG=1

# Plan generation speed (optional - these are the defaults)
GENAI_BATCH_CLAUSES=4
# 1 = one short module per request (faster answers); 0 = longer, more detailed modules
GENAI_COMPACT_OUTPUT=1
# 1 = the plan must cover every requirement (mandatory + recommended + optional); 0 = mandatory only
GENAI_COVER_ALL=1
GENAI_PARALLEL=32
GENAI_COVERAGE_ROUNDS=0
GENAI_TIME_BUDGET=45
# parts still running at the budget keep going and are merged into the plan automatically (1 = on)
GENAI_FINISH_IN_BACKGROUND=1
# after this many seconds, clauses still missing are re-sent as tiny requests (first answer wins); default 30% of the budget
GENAI_HEDGE_AFTER=14
# total seconds for "Regenerate selected modules", however many are selected (viva-friendly)
GENAI_REGEN_TIME_BUDGET=10
